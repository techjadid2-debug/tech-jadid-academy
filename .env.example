# ============================================================================
# Tech Jadid Akademiyasi — muhit o'zgaruvchilari.
# `.env.local` fayliga nusxalab, qiymatlarni to'ldiring.
# Hech biri to'ldirilmasa — loyiha DEMO rejimda ishlaydi (cookie asosida).
# ============================================================================

# ---- Supabase (DB + Auth + Storage) ----
# Bo'sh bo'lsa real auth o'chadi; demo faqat quyidagi alohida flag bilan yoqiladi.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Enrollment/progress/admin YOZISH uchun SHART (Dashboard → Settings → API).
SUPABASE_SERVICE_ROLE_KEY=

# Demo faqat local development uchun va aniq yoqilganda ishlaydi.
# Production'da bu qiymat true bo'lsa ham demo o'chiriladi.
ENABLE_DEMO_MODE=false

# Seller-first launchda false: yangi public register/ariza/cohort yaratish yopiq.
# Mavjud pending checkout va Telegram tasdiqlash ishlashda davom etadi.
PUBLIC_REGISTRATION_ENABLED=false

# Bir martalik admin bootstrap uchun. Script ishlatilgach .env.local'da saqlamang.
ADMIN_LOGIN=
ADMIN_INITIAL_PASSWORD=
ADMIN_NAME=Tech Jadid Admin

# ---- Sayt bazaviy URL (to'lovdan qaytish linklari) ----
NEXT_PUBLIC_APP_URL=
# Deploylar orasida Server Action ID'lari barqaror bo'lishi uchun 32+ bayt random kalit.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ---- Qo'lda to'lov rekvizitlari (saytda ko'rsatiladi) ----
# Xaridor chek va kurs/tarif ma'lumotini shu Telegram havolasi orqali yuboradi.
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
PAYMENT_TELEGRAM_URL=

# ---- Video (Cloudflare R2 / kelajakda Bunny) ----
# R2 bucket'ning public bazaviy URL'i. Har dars videosi HLS papkada:
#   <R2_PUBLIC_BASE>/<video_key>/index.m3u8  (masalan ai-asoslari/01/index.m3u8)
# Bo'sh bo'lsa: player "video tez orada" placeholder ko'rsatadi.
R2_PUBLIC_BASE=
# Kamida 32 belgili random secret; bo'sh/default bo'lsa video ataylab o'chadi.
VIDEO_SIGN_SECRET=

# ---- Bepul manual to'lov: Telegram bot + admin tasdig'i ----
# BotFather'dan olingan token, @ belgisisiz username va vergul bilan admin ID'lar.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_IDS=
TELEGRAM_WEBHOOK_SECRET=

# ---- Cron himoyasi ----
CRON_SECRET=

# ---- AI sandbox ("Sinab ko'ring") ----
# Vercel'da deploy bo'lsa OIDC avtomatik ishlaydi; lokalda `vercel env pull`
# yoki AI Gateway API kaliti kerak.
AI_GATEWAY_API_KEY=
AI_SANDBOX_MODEL=anthropic/claude-haiku-4.5
