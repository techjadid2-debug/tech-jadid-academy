# ============================================================================
# Tech Jadid Akademiyasi — muhit o'zgaruvchilari.
# `.env.local` fayliga nusxalab, qiymatlarni to'ldiring.
# Hech biri to'ldirilmasa — loyiha DEMO rejimda ishlaydi (cookie asosida).
# ============================================================================

# ---- Supabase (DB + Auth + Storage) ----
# Bo'sh bo'lsa: DEMO auth va enrollment (cookie) ishlatiladi.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Video (Cloudflare R2 / kelajakda Bunny) ----
# Bo'sh bo'lsa: player "video tez orada" placeholder ko'rsatadi.
R2_PUBLIC_BASE=
VIDEO_SIGN_SECRET=change-me-to-a-long-random-string

# ---- To'lov provayderlari ----
# Bo'sh bo'lsa: mock checkout (demo tasdiqlash) ishlaydi.
PAYME_MERCHANT_ID=
PAYME_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
UZUM_MERCHANT_ID=

# ---- Cron himoyasi ----
CRON_SECRET=

# ---- Auth (real rejim) ----
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
